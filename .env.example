# Supabase project settings (safe to expose in the browser when RLS is enabled).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Never add a service-role key to a VITE_ variable.

# Optional public build metadata. Do not put credentials here.
VITE_APP_VERSION=local

# Future AI provider configuration.
# These values are server-side placeholders and are intentionally NOT read by
# the browser. Connect them through a Supabase Edge Function or another secure
# backend when the providers exist.
VIDEO_AI_API_URL=
VIDEO_AI_API_KEY=server-side-only
LOCAL_AI_API_URL=
LOCAL_AI_API_KEY=server-side-only
